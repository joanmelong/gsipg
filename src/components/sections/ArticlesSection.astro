---
import Container from '../ui/Container.astro';
import { formatArticleDate, getSortedArticles } from '../../data/articles';

const sortedArticles = getSortedArticles();
const featuredArticle = sortedArticles[0];
const otherArticles = sortedArticles.slice(1);
---

<!-- ═══════════════════════════════════════════
     HERO : fond bleu 40% | image 60% | bloc vert centré sur la frontière
═══════════════════════════════════════════ -->
<section
  class="relative overflow-hidden bg-secondary"
  style="min-height: 340px;"
  aria-label="Actualités du GSIPG"
>
  <!-- Motif points sur le fond bleu -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.07]"
    style="background-image: radial-gradient(circle, #ffffff 1.5px, transparent 1.5px); background-size: 28px 28px;"
    aria-hidden="true"
  ></div>
  <!-- Motif diagonales -->
  <div
    class="pointer-events-none absolute inset-0 opacity-[0.04]"
    style="background: repeating-linear-gradient(-45deg, transparent, transparent 40px, #ffffff 40px, #ffffff 41px);"
    aria-hidden="true"
  ></div>

  <!-- Image école : occupe les 60% droits -->
  <div class="absolute inset-y-0 right-0 w-[60%]" aria-hidden="true">
    <img
      src="/images/about/about.jpg"
      alt=""
      class="h-full w-full object-cover object-center"
      loading="eager"
      width="900"
      height="400"
    />
    <!-- Léger voile bleu sur l'image pour cohérence -->
    <div class="absolute inset-0 bg-secondary/20"></div>
  </div>

  <!-- Bloc vert : centré sur la frontière 40%/60% -->
  <div
    class="absolute z-10 bg-[#00aa44] px-8 py-10 sm:px-12 sm:py-12 shadow-2xl"
    style="left: 40%; top: 50%; transform: translate(-50%, -50%); width: 480px; max-width: 70%; height: fit-content;"
  >
    <h1 class="font-subheading text-2xl font-bold normal-case leading-tight text-white sm:text-3xl lg:text-4xl">
      Les actualités de<br />La Petite Gloria
    </h1>
    <p class="mt-4 text-sm leading-relaxed text-white/90">
      Moments forts, projets pédagogiques et vie quotidienne de nos élèves — restez connectés à l'école.
    </p>
  </div>

  <!-- Espaceur pour hauteur de section -->
  <div class="min-h-[58vh]" aria-hidden="true"></div>
</section>

<!-- ═══════════════════════════════════════════
     SECTION ARTICLES
═══════════════════════════════════════════ -->
<section class="bg-white py-12 sm:py-16" aria-label="Dernières actualités">
  <Container>

    <!-- Label + titre -->
    <p class="text-[10px] font-bold uppercase tracking-[0.2em] text-neutral-text/60">
      Parcourez et lisez les dernières nouveautés
    </p>
    <h2 class="mt-2 text-2xl font-bold text-neutral-dark sm:text-3xl">
      Dernières Actualités
    </h2>

    <!-- ── SLIDER 60% + ARTICLE DÉTAIL 40% ── -->
    {featuredArticle && (
      <div class="mt-8 flex flex-col gap-6 lg:flex-row lg:items-stretch lg:gap-8">

        <!-- Slider : 60% gauche -->
        <div class="relative overflow-hidden lg:w-[60%]" id="news-slider">
          <div class="news-slides relative" id="news-slides-track">
            {sortedArticles.slice(0, 5).map((article, i) => (
              <div
                class:list={['news-slide transition-opacity duration-500', i === 0 ? 'opacity-100 block' : 'opacity-0 hidden']}
                data-slide-index={i}
              >
                <a href={`/actualites/${article.slug}`} class="group block">
                  <div class="relative overflow-hidden" style="aspect-ratio: 4/3;">
                    <img
                      src={article.image}
                      alt={article.imageAlt}
                      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                      loading={i === 0 ? 'eager' : 'lazy'}
                      width="700"
                      height="525"
                    />
                    <!-- Dégradé bas -->
                    <div class="absolute inset-0" style="background: linear-gradient(to top, rgba(0,0,0,0.70) 0%, rgba(0,0,0,0.2) 45%, transparent 75%);" aria-hidden="true"></div>
                    <!-- Titre + date + lire la suite en overlay bas -->
                    <div class="absolute bottom-0 left-0 p-5 sm:p-7">
                      <p class="font-subheading text-lg font-bold normal-case leading-snug text-white drop-shadow sm:text-xl lg:text-2xl">
                        {article.title}
                      </p>
                      <time datetime={article.date} class="mt-2 block text-sm text-white/80">
                        {formatArticleDate(article.date)}
                      </time>
                      <span class="mt-3 inline-flex items-center gap-1 text-sm font-semibold text-white/90 transition hover:text-white hover:gap-2">
                        Lire la suite
                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-4 w-4" aria-hidden="true">
                          <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </a>
              </div>
            ))}
          </div>

          <!-- Boutons prev / next -->
          <button
            type="button"
            id="slider-prev"
            aria-label="Article précédent"
            class="absolute left-3 top-1/2 z-20 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full bg-white/80 text-secondary shadow-md backdrop-blur-sm transition hover:bg-white hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M11.78 5.22a.75.75 0 0 1 0 1.06L8.06 10l3.72 3.72a.75.75 0 1 1-1.06 1.06l-4.25-4.25a.75.75 0 0 1 0-1.06l4.25-4.25a.75.75 0 0 1 1.06 0Z" clip-rule="evenodd" />
            </svg>
          </button>
          <button
            type="button"
            id="slider-next"
            aria-label="Article suivant"
            class="absolute right-3 top-1/2 z-20 -translate-y-1/2 flex h-10 w-10 items-center justify-center rounded-full bg-white/80 text-secondary shadow-md backdrop-blur-sm transition hover:bg-white hover:shadow-lg focus-visible:outline focus-visible:outline-2 focus-visible:outline-secondary"
          >
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path fill-rule="evenodd" d="M8.22 5.22a.75.75 0 0 1 1.06 0l4.25 4.25a.75.75 0 0 1 0 1.06l-4.25 4.25a.75.75 0 0 1-1.06-1.06L11.94 10 8.22 6.28a.75.75 0 0 1 0-1.06Z" clip-rule="evenodd" />
            </svg>
          </button>

          <!-- Dots -->
          <div class="mt-3 flex items-center justify-center gap-2 pb-1" role="tablist" aria-label="Slides">
            {sortedArticles.slice(0, 5).map((_, i) => (
              <button
                type="button"
                role="tab"
                data-dot={i}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-label={`Slide ${i + 1}`}
                class:list={[
                  'h-2 rounded-full transition-all duration-300 focus-visible:outline focus-visible:outline-2 focus-visible:outline-secondary',
                  i === 0 ? 'w-6 bg-secondary' : 'w-2 bg-neutral-dark/25 hover:bg-secondary/50',
                ]}
              ></button>
            ))}
          </div>
        </div>

        <!-- Suivez-nous : 40% droite -->
        <div class="flex flex-col justify-center lg:w-[40%]">
          <h3 class="text-lg font-bold text-neutral-dark">
            Suivez-nous
          </h3>
          <p class="mt-2 text-sm text-neutral-text">
            Restez connectés à La Petite Gloria sur nos différentes plateformes.
          </p>

          <div class="mt-6 flex flex-col gap-3">

            <!-- WhatsApp -->
            <a
              href="https://wa.me/237699918562"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 bg-[#25D366] px-5 py-3 text-white shadow-sm transition hover:brightness-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M12 0C5.373 0 0 5.373 0 12c0 2.126.558 4.117 1.532 5.845L.057 23.927l6.242-1.637A11.945 11.945 0 0 0 12 24c6.627 0 12-5.373 12-12S18.627 0 12 0zm0 21.818a9.818 9.818 0 0 1-5.003-1.366l-.359-.213-3.714.974.99-3.62-.234-.372A9.818 9.818 0 1 1 12 21.818z"/>
              </svg>
              <span class="font-semibold">WhatsApp</span>
            </a>

            <!-- Facebook -->
            <a
              href="https://facebook.com/gsipg"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 bg-[#1877F2] px-5 py-3 text-white shadow-sm transition hover:brightness-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path d="M24 12.073C24 5.404 18.627 0 12 0S0 5.404 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.268h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
              </svg>
              <span class="font-semibold">Facebook</span>
            </a>

            <!-- Instagram -->
            <a
              href="https://instagram.com/gsipg"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 px-5 py-3 text-white shadow-sm transition hover:brightness-110"
              style="background: linear-gradient(45deg, #f09433, #e6683c, #dc2743, #cc2366, #bc1888);"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838a6.162 6.162 0 1 0 0 12.324 6.162 6.162 0 0 0 0-12.324zM12 16a4 4 0 1 1 0-8 4 4 0 0 1 0 8zm6.406-11.845a1.44 1.44 0 1 0 0 2.881 1.44 1.44 0 0 0 0-2.881z"/>
              </svg>
              <span class="font-semibold">Instagram</span>
            </a>

            <!-- LinkedIn -->
            <a
              href="https://linkedin.com/company/gsipg"
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-4 bg-[#0A66C2] px-5 py-3 text-white shadow-sm transition hover:brightness-110"
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5 shrink-0" aria-hidden="true">
                <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
              </svg>
              <span class="font-semibold">LinkedIn</span>
            </a>

          </div>
        </div>

      </div>
    )}

    <!-- ── GRILLE 3 CARTES ── -->
    {otherArticles.length > 0 && (
      <div class="mt-10 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {otherArticles.slice(0, 6).map((article) => (
          <article class="group flex flex-col overflow-hidden bg-white shadow-sm ring-1 ring-border/60 transition duration-300 hover:shadow-md">
            <a href={`/actualites/${article.slug}`} class="block overflow-hidden" tabindex="-1" aria-hidden="true">
              <div class="aspect-[16/10] overflow-hidden">
                <img
                  src={article.image}
                  alt={article.imageAlt}
                  class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
                  loading="lazy"
                  width="400"
                  height="250"
                />
              </div>
            </a>
            <div class="flex flex-1 flex-col gap-2 p-5">
              <a href={`/actualites/${article.slug}`} class="text-sm font-semibold leading-snug text-secondary hover:underline sm:text-base">
                {article.title}
              </a>
              <time datetime={article.date} class="text-xs text-neutral-text">
                {formatArticleDate(article.date)}
              </time>
              <div class="h-px w-12 bg-secondary/40"></div>
              <p class="line-clamp-3 flex-1 text-xs leading-relaxed text-neutral-text sm:text-sm">
                {article.excerpt}
              </p>
              <a href={`/actualites/${article.slug}`} class="mt-1 inline-flex items-center gap-1 text-xs font-semibold text-secondary transition hover:gap-2">
                Lire la suite
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="h-3.5 w-3.5" aria-hidden="true">
                  <path fill-rule="evenodd" d="M3 10a.75.75 0 0 1 .75-.75h10.638L10.23 5.29a.75.75 0 1 1 1.04-1.08l5.5 5.25a.75.75 0 0 1 0 1.08l-5.5 5.25a.75.75 0 1 1-1.04-1.08l4.158-3.96H3.75A.75.75 0 0 1 3 10Z" clip-rule="evenodd" />
                </svg>
              </a>
            </div>
          </article>
        ))}
      </div>
    )}

  </Container>
</section>

<script>
  function initSlider() {
    const track = document.getElementById('news-slides-track');
    if (!track) return;

    const slides = Array.from(track.querySelectorAll<HTMLElement>('.news-slide'));
    const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const prevBtn = document.getElementById('slider-prev');
    const nextBtn = document.getElementById('slider-next');
    if (slides.length <= 1) return;

    let current = 0;
    let timer: ReturnType<typeof setInterval>;

    function goTo(index: number) {
      slides[current].classList.remove('opacity-100', 'block');
      slides[current].classList.add('opacity-0', 'hidden');
      dots[current]?.classList.remove('w-6', 'bg-secondary');
      dots[current]?.classList.add('w-2', 'bg-neutral-dark/25');
      dots[current]?.setAttribute('aria-selected', 'false');

      current = (index + slides.length) % slides.length;

      slides[current].classList.remove('opacity-0', 'hidden');
      slides[current].classList.add('opacity-100', 'block');
      dots[current]?.classList.remove('w-2', 'bg-neutral-dark/25');
      dots[current]?.classList.add('w-6', 'bg-secondary');
      dots[current]?.setAttribute('aria-selected', 'true');
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAuto() { timer = setInterval(next, 4000); }
    function stopAuto() { clearInterval(timer); }

    prevBtn?.addEventListener('click', () => { stopAuto(); prev(); startAuto(); });
    nextBtn?.addEventListener('click', () => { stopAuto(); next(); startAuto(); });

    dots.forEach((dot, i) => {
      dot.addEventListener('click', () => { stopAuto(); goTo(i); startAuto(); });
    });

    track.addEventListener('mouseenter', stopAuto);
    track.addEventListener('mouseleave', startAuto);

    startAuto();
  }

  initSlider();
  document.addEventListener('astro:page-load', initSlider);
</script>
