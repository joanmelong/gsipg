---
import Container from '../ui/Container.astro';
import { galleryHero } from '../../data/gallery';
---

<section class="bg-white py-10 sm:py-12 lg:py-14" aria-label="Introduction galerie">
  <Container>
    <div class="mx-auto max-w-5xl text-center">
      <h1 class="font-subheading text-6xl font-bold normal-case leading-tight tracking-normal text-secondary sm:text-7xl lg:text-[5.5rem]">
        {galleryHero.title}
      </h1>
      <p class="mx-auto mt-5 max-w-3xl text-base leading-relaxed text-secondary/85 sm:mt-6 sm:text-lg">
        {galleryHero.subtitle}
      </p>
    </div>
  </Container>
</section>
