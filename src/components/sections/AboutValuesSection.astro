---
import Container from '../ui/Container.astro';
import Section from '../ui/Section.astro';
import Card from '../ui/Card.astro';
import { values } from '../../data/about';
---

<Section ariaLabel="Nos valeurs fondamentales">
  <Container>
    <div class="mb-12 text-center">
      <h2>Nos valeurs fondamentales</h2>
      <p class="mx-auto mt-4 max-w-2xl text-neutral-text">
        Les piliers qui guident chaque décision pédagogique au GSIPG.
      </p>
    </div>
    <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {
        values.map((value) => (
          <Card title={value.title} description={value.description} />
        ))
      }
    </div>
  </Container>
</Section>

