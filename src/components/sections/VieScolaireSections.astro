---
import Container from '../ui/Container.astro';
import { vieScolaireContentSections, type VieScolaireTheme } from '../../data/vie-scolaire';

const themeClasses: Record<
  VieScolaireTheme,
  { section: string; title: string; text: string; badge: string; note: string }
> = {
  white: {
    section: 'bg-white',
    title: 'text-secondary',
    text: 'text-neutral-text',
    badge: 'bg-neutral-bg text-secondary shadow-sm ring-1 ring-border',
    note: 'border-border bg-neutral-bg text-neutral-text',
  },
  primary: {
    section: 'bg-primary/20',
    title: 'text-secondary',
    text: 'text-neutral-text',
    badge: 'bg-white text-secondary shadow-sm',
    note: 'border-primary/40 bg-white/70 text-neutral-text',
  },
  secondary: {
    section: 'bg-secondary',
    title: 'text-white',
    text: 'text-white/90',
    badge: 'bg-white/15 text-white backdrop-blur-sm',
    note: 'border-white/25 bg-white/10 text-white/90',
  },
  green: {
    section: 'bg-accent-green/15',
    title: 'text-accent-green',
    text: 'text-neutral-text',
    badge: 'bg-white text-accent-green shadow-sm',
    note: 'border-accent-green/30 bg-white/80 text-neutral-text',
  },
  orange: {
    section: 'bg-accent-orange/15',
    title: 'text-accent-orange',
    text: 'text-neutral-text',
    badge: 'bg-white text-accent-orange shadow-sm',
    note: 'border-accent-orange/35 bg-white/80 text-neutral-text',
  },
};
---

{
  vieScolaireContentSections.map((section, index) => {
    // Section 0 (horaires) : image à droite
    // Section 1 (restauration) : image à gauche
    // Section 2 (transports) : image à droite
    // Section 3 (inscriptions) : image à gauche
    const imageLeft = index % 2 === 1; // Impair = image à gauche
    const theme = themeClasses[section.theme];
    const isFirstSection = index === 0;

    return isFirstSection ? (
      // Première section : deux blocs égaux (50/50) avec séparation oblique
      <section
        id={section.id}
        class="scroll-mt-28 mt-10 sm:mt-12 lg:mt-16"
        aria-labelledby={`${section.id}-title`}
      >
        <div class="relative grid grid-cols-1 lg:grid-cols-2">
          <!-- Bloc droit : Image (affiché en premier sur mobile) -->
          <div class="relative order-1 h-[350px] lg:order-2 lg:h-[600px]">
            <div class="absolute inset-0 lg:clip-path-[polygon(5%_0,100%_0,100%_100%,0_100%)]" style="clip-path: polygon(0 0, 100% 0, 100% 100%, 0 100%); lg:clip-path: polygon(5% 0, 100% 0, 100% 100%, 0 100%);">
              <img
                src={section.image.src}
                alt={section.image.alt}
                class="h-full w-full object-cover"
                loading="eager"
                width="800"
                height="600"
              />
            </div>
          </div>

          <!-- Bloc gauche : Texte avec fond coloré (affiché en second sur mobile) -->
          <div class={`relative order-2 flex items-center justify-center px-8 py-12 sm:px-12 sm:py-14 lg:order-1 lg:px-16 lg:py-16 ${theme.section}`}>
            <!-- Forme oblique pour la séparation -->
            <div class="absolute right-0 top-0 hidden h-full w-20 lg:block" style="background: inherit; clip-path: polygon(100% 0, 0 0, 100% 100%);">
            </div>
            
            <div class="relative z-10 w-full max-w-xl">
              <h2
                id={`${section.id}-title`}
                class={`font-subheading text-2xl font-bold normal-case tracking-normal sm:text-3xl lg:text-4xl ${theme.title}`}
              >
                {section.title}
              </h2>

              <!-- Deux blocs empilés verticalement -->
              <div class="mt-6 space-y-4">
                <!-- Bloc Maternelle -->
                <div class={`rounded-2xl px-5 py-4 ${theme.badge}`}>
                  <p class="text-xs font-bold uppercase tracking-widest opacity-70">Maternelle</p>
                  <div class="mt-3 space-y-1 text-sm font-medium">
                    <div class="flex justify-between"><span>Lundi, Mardi, Jeudi</span><span class="font-bold">7h30 – 13h30</span></div>
                    <div class="flex justify-between"><span>Mercredi, Vendredi</span><span class="font-bold">7h30 – 12h00</span></div>
                  </div>
                </div>

                <!-- Bloc Primaire -->
                <div class={`rounded-2xl px-5 py-4 ${theme.badge}`}>
                  <p class="text-xs font-bold uppercase tracking-widest opacity-70">Primaire</p>
                  <div class="mt-3 space-y-1 text-sm font-medium">
                    <div class="flex justify-between"><span>Lundi, Mardi, Jeudi</span><span class="font-bold">7h30 – 15h00</span></div>
                    <div class="flex justify-between"><span>Mercredi, Vendredi</span><span class="font-bold">7h30 – 13h00</span></div>
                  </div>
                </div>
              </div>

              <!-- Récréations -->
              <div class={`mt-4 flex items-center gap-3 rounded-2xl border px-5 py-3 text-sm ${theme.note}`}>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 shrink-0 opacity-60" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
                </svg>
                <span>2 pauses récréation de <strong>30 min</strong> chacune</span>
              </div>
            </div>
          </div>
        </div>
      </section>
    ) : (
      // Autres sections : layout 50/50 avec alternance image gauche/droite
      <section
        id={section.id}
        class="scroll-mt-28"
        aria-labelledby={`${section.id}-title`}
      >
        <div class="relative grid grid-cols-1 lg:grid-cols-2">
          {/* Image à gauche si index impair, à droite si pair */}
          {imageLeft ? (
            <>
              {/* Image à gauche */}
              <div class="relative h-[350px] lg:order-1 lg:h-[600px]">
                <img
                  src={section.image.src}
                  alt={section.image.alt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  width="800"
                  height="600"
                />
              </div>

              {/* Texte à droite */}
              <div class={`flex items-center justify-center px-8 py-12 sm:px-12 sm:py-14 lg:order-2 lg:px-16 lg:py-16 ${theme.section}`}>
                <div class="w-full max-w-xl">
                  <h2
                    id={`${section.id}-title`}
                    class={`font-subheading text-2xl font-bold normal-case tracking-normal sm:text-3xl lg:text-4xl ${theme.title}`}
                  >
                    {section.title}
                  </h2>

                  {'highlight' in section && section.highlight && (
                    <p class={`mt-5 text-lg font-semibold leading-snug sm:text-xl ${theme.title}`}>
                      {section.highlight}
                    </p>
                  )}

                  {'description' in section && section.description && (
                    <p class={`mt-4 leading-relaxed ${theme.text}`}>{section.description}</p>
                  )}

                  {'badges' in section && section.badges && (
                    <div class="mt-8 flex flex-wrap gap-4">
                      {section.badges.map((badge) => (
                        <div class={`rounded-2xl px-6 py-4 ${theme.badge}`}>
                          <span class="block text-xs font-semibold uppercase tracking-wider opacity-75">
                            {badge.label}
                          </span>
                          <span class="mt-1 block font-subheading text-xl font-bold">{badge.value}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  {'bonus' in section && section.bonus && (
                    <div class={`mt-6 inline-flex rounded-2xl px-5 py-3 text-sm font-semibold ${theme.badge}`}>
                      {section.bonus}
                    </div>
                  )}

                  {'note' in section && section.note && (
                    <p class={`mt-6 rounded-2xl border px-5 py-4 text-sm leading-relaxed ${theme.note}`}>
                      {section.note}
                    </p>
                  )}
                </div>
              </div>
            </>
          ) : (
            <>
              {/* Image à droite - affichée en premier sur mobile */}
              <div class="relative order-1 h-[350px] lg:order-2 lg:h-[600px]">
                <img
                  src={section.image.src}
                  alt={section.image.alt}
                  class="h-full w-full object-cover"
                  loading="lazy"
                  width="800"
                  height="600"
                />
              </div>

              {/* Texte à gauche - affiché en second sur mobile */}
              <div class={`order-2 flex items-center justify-center px-8 py-12 sm:px-12 sm:py-14 lg:order-1 lg:px-16 lg:py-16 ${theme.section}`}>
                <div class="w-full max-w-xl">
                  <h2
                    id={`${section.id}-title`}
                    class={`font-subheading text-2xl font-bold normal-case tracking-normal sm:text-3xl lg:text-4xl ${theme.title}`}
                  >
                    {section.title}
                  </h2>

                  {'highlight' in section && section.highlight && (
                    <p class={`mt-5 text-lg font-semibold leading-snug sm:text-xl ${theme.title}`}>
                      {section.highlight}
                    </p>
                  )}

                  {'description' in section && section.description && (
                    <p class={`mt-4 leading-relaxed ${theme.text}`}>{section.description}</p>
                  )}

                  {'badges' in section && section.badges && (
                    <div class="mt-8 flex flex-wrap gap-4">
                      {section.badges.map((badge) => (
                        <div class={`rounded-2xl px-6 py-4 ${theme.badge}`}>
                          <span class="block text-xs font-semibold uppercase tracking-wider opacity-75">
                            {badge.label}
                          </span>
                          <span class="mt-1 block font-subheading text-xl font-bold">{badge.value}</span>
                        </div>
                      ))}
                    </div>
                  )}

                  {'bonus' in section && section.bonus && (
                    <div class={`mt-6 inline-flex rounded-2xl px-5 py-3 text-sm font-semibold ${theme.badge}`}>
                      {section.bonus}
                    </div>
                  )}

                  {'note' in section && section.note && (
                    <p class={`mt-6 rounded-2xl border px-5 py-4 text-sm leading-relaxed ${theme.note}`}>
                      {section.note}
                    </p>
                  )}
                </div>
              </div>
            </>
          )}
        </div>
      </section>
    );
  })
}
